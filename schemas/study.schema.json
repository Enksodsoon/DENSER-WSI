{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["primary_projects", "reserve_projects", "target_counts", "reduced_counts", "minimum_evaluable_final_slides", "partition_unit", "primary_mpp_um", "robustness_mpp_um", "evidence_cell_um", "repair_halo_um", "automatic_freeze", "final_full_grid", "sampled_tile_extrapolation", "standard_uses_shared_he_v1", "standard_uses_shared_lossless_fallback", "minimum_standard_codec_families", "primary_certificate_mode", "claims"],
  "properties": {
    "$schema": {"type": "string"},
    "primary_projects": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "string"}, "uniqueItems": true},
    "reserve_projects": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "target_counts": {"type": "object"},
    "reduced_counts": {"type": "object"},
    "minimum_evaluable_final_slides": {"const": 18},
    "partition_unit": {"const": "case_group_sha256"},
    "primary_mpp_um": {"prefixItems": [{"const": 0.2}, {"const": 0.3}], "minItems": 2, "maxItems": 2},
    "robustness_mpp_um": {"prefixItems": [{"const": 0.45}, {"const": 0.55}], "minItems": 2, "maxItems": 2},
    "evidence_cell_um": {"const": 8.0},
    "repair_halo_um": {"const": 2.0},
    "automatic_freeze": {"const": true},
    "final_full_grid": {"const": true},
    "sampled_tile_extrapolation": {"const": false},
    "standard_uses_shared_he_v1": {"const": true},
    "standard_uses_shared_lossless_fallback": {"const": true},
    "minimum_standard_codec_families": {"type": "integer", "minimum": 2},
    "primary_certificate_mode": {"const": "self_verifying"},
    "claims": {"type": "object", "additionalProperties": {"const": false}}
  },
  "additionalProperties": false
}
