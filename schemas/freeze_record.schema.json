{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Enksodsoon/DENSER-WSI/schemas/freeze_record.schema.json",
  "title": "Immutable DENSER final holdout freeze",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version", "git_commit", "clean_tree", "container_image_digest", "sbom_digest",
    "dependency_versions", "configuration_digest", "partition_manifest_digest",
    "reserve_manifest_digest", "selected_profile_id", "profile_digest",
    "standard_candidate_ladders", "evidence_tolerances", "evidence_implementation_digest",
    "analysis_code_digest", "random_seeds", "expected_final_slide_count", "freeze_digest"
  ],
  "properties": {
    "version": {"const": "DENSER-freeze-1"},
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "clean_tree": {"const": true},
    "container_image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sbom_digest": {"$ref": "#/$defs/digest"},
    "dependency_versions": {"type": "array", "minItems": 1},
    "configuration_digest": {"$ref": "#/$defs/digest"},
    "partition_manifest_digest": {"$ref": "#/$defs/digest"},
    "reserve_manifest_digest": {"$ref": "#/$defs/digest"},
    "selected_profile_id": {"type": "string", "minLength": 1},
    "profile_digest": {"$ref": "#/$defs/digest"},
    "standard_candidate_ladders": {"type": "array", "minItems": 1},
    "evidence_tolerances": {"type": "array", "minItems": 1},
    "evidence_implementation_digest": {"$ref": "#/$defs/digest"},
    "analysis_code_digest": {"$ref": "#/$defs/digest"},
    "random_seeds": {"type": "array", "items": {"type": "integer"}, "minItems": 1},
    "expected_final_slide_count": {"type": "integer", "minimum": 1},
    "freeze_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
